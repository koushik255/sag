# Copy this file to .env, replace the values, then run:
#   python3 server/stopandgo_server.py
# The real .env is ignored by Git.

# Directories on the machine running the server.
STOPANDGO_ROOT=/path/to/downloads
STOPANDGO_EXPORT_ROOT=/path/to/media-exports

# Use 127.0.0.1 with Tailscale Serve or an SSH tunnel. To connect directly over
# your tailnet, use this server's Tailscale IP here instead.
STOPANDGO_HOST=127.0.0.1
STOPANDGO_PORT=8765

# The URL that mpv clients use. Omit it when clients connect through an SSH
# tunnel at 127.0.0.1:8765.
STOPANDGO_PUBLIC_BASE_URL=https://your-server.your-tailnet.ts.net

# Required when binding directly to a network interface. Generate with:
#   openssl rand -hex 32
STOPANDGO_TOKEN=replace-with-a-random-token

# Optional executable and validation settings.
STOPANDGO_FFPROBE=ffprobe
STOPANDGO_FFMPEG=ffmpeg
STOPANDGO_PROBE_TIMEOUT=15
