{
  "name": "stopandgo-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "StopAndGo desktop media player prototype",
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env STOPANDGO_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@mediabunny/ac3": "^1.54.0",
    "mediabunny": "^1.54.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "vite": "^8.2.1",
    "wait-on": "^9.0.3"
  }
}
